# MatOpt backend configuration — copy to .env and fill in at least one provider key:
#   cp .env.example .env

# ── App ──────────────────────────────────────────────────────────────────
DEBUG=false
HOST=0.0.0.0
PORT=8000
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# DATA_DIR=./data                  # sqlite db + per-conversation workspaces

# ── Default model (must be one of the catalog ids in app/llm/catalog.py) ─
DEFAULT_PROVIDER=deepseek          # deepseek | openai | qwen
DEFAULT_MODEL=deepseek-v4-pro
DEFAULT_REASONING=medium           # off | low | medium | high | max

# ── DeepSeek (deepseek-v4-pro, deepseek-v4-flash) ────────────────────────
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── OpenAI (gpt-5.6-terra, gpt-5.6-luna) ─────────────────────────────────
OPENAI_API_KEY=
# OPENAI_BASE_URL=                 # optional proxy / compatible gateway

# ── Qwen via Alibaba Cloud Model Studio / DashScope (qwen3.8 / 3.7 / 3.5) ─
QWEN_API_KEY=
QWEN_REGION=intl                   # intl (dashscope-intl) | cn (dashscope.aliyuncs.com)
# QWEN_BASE_URL=                   # overrides the region default

# ── Optional tools ───────────────────────────────────────────────────────
WOLFRAM_APP_ID=

# ── Agent loop ───────────────────────────────────────────────────────────
# AGENT_MAX_STEPS=40               # LLM calls per turn
# AGENT_MAX_CONSECUTIVE_FAILURES=4
# VERIFY_ROUNDS=2                  # verify-mode rounds
# TOOL_TIMEOUT=120                 # default seconds per python/bash call
# TOOL_MAX_TIMEOUT=900
# KERNEL_IDLE_SECONDS=1800
# LLM_TIMEOUT=600
# MAX_UPLOAD_SIZE_MB=200

# ── Skills ───────────────────────────────────────────────────────────────
# SKILLS_DIRS=                      # extra comma-separated skill directories
# SKILL_AUTO_ACTIVATE=true
# SKILL_AUTO_ACTIVATE_MAX=2
# SKILL_CATALOG_LIMIT=16

# ── MCP ──────────────────────────────────────────────────────────────────
# MCP_ENABLED=true
# MCP_CONFIG_PATH=                  # default: <repo>/mcp.json (see mcp.json.example)
# MCP_MOUNT_PATH=/mcp

# ── MinerU document OCR (optional; see scripts/setup_mineru.sh) ──────────
# MINERU_COMMAND=/abs/path/to/.venv-mineru/bin/mineru
# MINERU_BACKEND=pipeline
# MINERU_DEVICE=auto               # auto | cpu | mps | cuda
# MINERU_LANG=en
# MINERU_MODEL_SOURCE=huggingface  # huggingface | modelscope
# MINERU_TIMEOUT=900
