# MatOpt backend configuration — copy to .env and fill in the DeepSeek key:
#   cp .env.example .env

# ── App ──────────────────────────────────────────────────────────────────
DEBUG=false
HOST=0.0.0.0
PORT=8000
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# DATA_DIR=./data                  # sqlite db + per-conversation workspaces

# ── Default model (must be one of the catalog ids in app/llm/catalog.py) ─
DEFAULT_PROVIDER=deepseek
DEFAULT_MODEL=deepseek-flash
DEFAULT_REASONING=high             # off | low | high | max

# ── DeepSeek V4.1 Flash (only live model: deepseek-flash) ───────────────
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Optional tools ───────────────────────────────────────────────────────
WOLFRAM_APP_ID=
# Lean 4 proof checking (lean_check). scripts/setup_lean.sh installs Lean and a
# Mathlib project; without these the tool uses ~/.elan/bin/lean when present.
# LEAN_PROJECT_DIR=/abs/path/to/backend/lean
# LEAN_COMMAND=
# LEAN_TIMEOUT=300

# ── Automatic web search for current information. Default engine: ddgs.
# WEB_SEARCH_ENABLED=true
# SEARXNG_URL=http://127.0.0.1:8080    # self-hosted SearXNG, preferred if you run one
# TAVILY_API_KEY=                       # ChatGPT-style research API
# BRAVE_SEARCH_API_KEY=                 # Brave Search API

# ── Misalignment monitor (local heuristic analog of Astra monitoring)
# ALIGN_MONITOR=true
# ALIGN_MONITOR_LLM=false

# ── Agent loop ───────────────────────────────────────────────────────────
# AGENT_MAX_STEPS=40               # LLM calls per turn
# AGENT_MAX_CONSECUTIVE_FAILURES=4
# RUN_MAX_MODEL_ATTEMPTS=80         # worker + retries + checks + delegated calls; document OCR pages are accounted but not capped
# RUN_MAX_TOOL_STARTS=160           # native envelope and actual delegated handlers
# RUN_TIMEOUT_SECONDS=1800         # absolute deadline; paused time is included
# LOOP_POLICY=operation            # exact-operation failure limits; legacy restores whole-tool blocking
# VERIFY_ROUNDS=2                  # at most two checks and one complete correction
# DIAGNOSTICS_ENABLED=false        # operator opt-in for raw events/requests/trajectory
# TOOL_TIMEOUT=120                 # default seconds per python/bash call
# TOOL_MAX_TIMEOUT=900
# KERNEL_IDLE_SECONDS=1800
# LLM_TIMEOUT=600
# MAX_OUTPUT_TOKENS=0              # 0 uses provider defaults; maximum 393216
# History uses the model's full 1,048,576-token window less this reply reserve;
# compaction summarises old turns only when that is reached.
# CONTEXT_RESERVE_TOKENS=65536
# HISTORY_CHAR_BUDGET=             # unset: derived from the context window
# TOOL_MAX_OUTPUT_CHARS=100000     # per tool call
# MAX_UPLOAD_SIZE_MB=200

# ── Agent action environment (what `bash` and the `python` kernel inherit) ─
# Children get the explicit allowlist in app/agent/child_env.py, not this
# process's environment, so DEEPSEEK_API_KEY & co. are not readable from an
# agent's shell or kernel. false restores the old ambient-environment
# behaviour — only as a temporary unblock for tooling that needs an inherited
# variable (proxy, CA bundle, model-download token); it re-exposes every key
# in this file to anything the agent runs.
# CHILD_ENV_ALLOWLIST=true
# Mask credential-shaped strings (sk-…, Bearer …, AKIA…) in tool output.
# REDACT_TOOL_OUTPUT=true

# ── Execution policy (ported from Codex; docs/CODEX-INTEGRATION.md) ──
# OS sandbox around bash, lean_check and the Jupyter kernel:
# off | workspace-write | read-only | external (already in a container).
# workspace-write: children write only the workspace and temp, cannot read the
# data directory (other chats, the database), backend/.env or ~/.ssh & co.
# SANDBOX_MODE=off
# SANDBOX_NETWORK=true            # outbound network inside the sandbox
# SANDBOX_BACKEND=auto            # auto | seatbelt (macOS) | bwrap (Linux) | none
# Extra prefix rules for bash (TOML [[rule]] pattern/decision/justification).
# EXEC_RULES_PATH=
# Command hooks (PreToolUse, PostToolUse, UserPromptSubmit, SessionStart, Stop).
# They run as the backend user: keep the file operator-owned.
# HOOKS_ENABLED=false
# HOOKS_PATH=                      # default: <DATA_DIR>/hooks.json
# HOOK_TIMEOUT=60
# AGENTS.md from ~/.matopt and DATA_DIR (system prompt) and the workspace (turn context).
# AGENTS_MD_ENABLED=true
# Approvals for risky calls (exec rules that say "prompt", destructive tools,
# write-capable MCP tools): off | user (ask in the UI) | guardian (reviewer model).
# APPROVALS_REVIEWER=off
# APPROVAL_TIMEOUT=600
# GUARDIAN_TIMEOUT=60
# GUARDIAN_FAIL_CLOSED=true
# Feature toggles, plugin install and config import through the HTTP API.
# Set false when the sandbox allows network (the kernel can reach the API).
# SETTINGS_API_WRITABLE=true
# Sub-agents, memories and tools-from-Python (also toggled in Settings → Features).
# SUBAGENTS_ENABLED=false
# SUBAGENT_MAX_CONCURRENT=3
# MEMORIES_ENABLED=false
# CODE_MODE_ENABLED=false
# User config layer: ~/.matopt/config.toml (or MATOPT_CONFIG), with [features]
# and [profiles.<name>] tables; MATOPT_PROFILE selects a profile.
# Model-request retries: exponential backoff with jitter, Retry-After honoured.
# LLM_MAX_RETRIES=4
# LLM_RETRY_BASE_DELAY=0.2

# Optional pricing per million tokens, keyed by provider/model. Each entry
# declares input/output, optional cache_read/cache_write, currency and as_of.
# No current prices are assumed. Empty means token reporting only.
# MODEL_PRICING={}
# Spend checks run before the next request; a single call can exceed the limit.
# MAX_TURN_COST=
# MAX_CONVERSATION_COST=

# ── OpenTelemetry (optional) ─────────────────────────────────────────────
# pip install -r requirements-otel.txt, then point at any OTLP/HTTP collector
# (Langfuse, Phoenix, Jaeger). Each finished turn exports one GenAI span tree.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=matopt
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false   # true also exports prompts and tool I/O

# ── Skills ───────────────────────────────────────────────────────────────
# SKILLS_DIRS=                      # extra comma-separated skill directories
# SKILL_AUTO_ACTIVATE=true
# SKILL_AUTO_ACTIVATE_MAX=2
# SKILL_CATALOG_LIMIT=16

# ── MCP ──────────────────────────────────────────────────────────────────
# MCP_ENABLED=true
# MCP_CONFIG_PATH=                  # default: <repo>/mcp.json (see mcp.json.example)
# MCP_MOUNT_PATH=/mcp
# HTTP /mcp has no authentication by default (stdio never needs it). Before
# exposing it beyond this machine, set a static bearer token:
# MCP_AUTH_TOKEN=
# or make /mcp an OAuth resource server for hosts that require OAuth
# (Claude.ai, ChatGPT). Tokens are JWTs from your authorization server:
# MCP_PUBLIC_URL=https://matopt.example.com
# MCP_OAUTH_ISSUER=https://auth.example.com/
# MCP_OAUTH_JWKS_URI=https://auth.example.com/.well-known/jwks.json
# MCP_OAUTH_AUDIENCE=                # default: <MCP_PUBLIC_URL><MCP_MOUNT_PATH>
# MCP_OAUTH_SCOPES=                  # comma-separated required scopes

# ── Data agent (backend/data_agent_app at /api/v1) ────
# DATA_AGENT_ENABLED=true
# The data agent shares DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL and uses only deepseek-flash.

# ── Voice: local Whisper transcription + Kokoro speech (models in DATA_DIR/models) ──
# SPEECH_ENABLED=true
# SPEECH_PREFETCH=true             # download/load models at startup in the background
# WHISPER_MODEL=small              # tiny | base | small | medium | large-v3 | turbo

# ── PDF and screenshot understanding (uses the same DeepSeek key/model) ─
# Newly attached PDFs/images are read automatically before the agent answers.
# PDF pages are rendered locally, then sent as image_url blocks; no OCR vendor.
# Originals stay intact. Extracted Markdown and page scope appear in Activity.
# DOCUMENT_OCR_ENABLED=true
# DOCUMENT_AUTO_PARSE=true
# DOCUMENT_OCR_MAX_PAGES=500       # per call; whole documents by default
# DOCUMENT_OCR_MAX_FILES=20        # automatic documents per user turn
# DOCUMENT_OCR_CONCURRENCY=8       # pages read in parallel
# DOCUMENT_OCR_MAX_FILE_MB=200
# DOCUMENT_OCR_MAX_DIMENSION=2048  # preserve aspect ratio
# DOCUMENT_OCR_MAX_PIXELS=32000000 # decoded screenshot safety bound
# DOCUMENT_OCR_PAGE_TIMEOUT=90
# DOCUMENT_OCR_TIMEOUT=1800
# DOCUMENT_OCR_MAX_TOKENS=6000     # per-page transcription output limit
# DOCUMENT_PREVIEW_CHARS=6000     # full Markdown is retained in parsed/

# ── Intelligent UI ──
# UI tools require client capability ui_version=1 in addition to these flags.
UI_NATIVE_ENABLED=true
UI_MINI_APPS_ENABLED=true
# Dedicated static sandbox origin; no API proxy. Default: app host on port 3001.
# UI_SANDBOX_ORIGIN=http://localhost:3001
