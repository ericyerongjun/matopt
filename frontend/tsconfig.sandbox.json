{
    // The sandbox runtime and test harness are plain JavaScript, so they get
    // type-aware checking without the annotations strict mode would require.
    "extends": "./tsconfig.json",
    "compilerOptions": { "allowJs": true, "checkJs": true, "strict": false, "noImplicitAny": false },
    "include": ["sandbox", "test"],
    "exclude": ["node_modules", "dist"],
    "references": []
}
