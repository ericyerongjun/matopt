{
    "name": "matopt",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p tsconfig.sandbox.json",
        "lint": "eslint src",
        "preview": "vite preview",
        "test": "node --max-old-space-size=512 --experimental-strip-types --import ./test/register.mjs --test --test-concurrency=1 --test-timeout=20000 \"src/**/*.test.{ts,tsx}\" \"sandbox/*.test.mjs\"",
        "sandbox": "node sandbox/server.mjs",
        "check:ui-contract": "python3 ../scripts/generate_ui_types.py --check"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/newsreader": "^5.3.0",
        "@fontsource/carlito": "^5.3.0",
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@pierre/diffs": "^1.1.22",
        "@pixiv/three-vrm": "^3.5.5",
        "@streamdown/cjk": "^1.0.3",
        "@streamdown/code": "^1.1.1",
        "@streamdown/math": "^1.0.2",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.3.5",
        "chart.js": "^4.4.8",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "katex": "^0.19.1",
        "lucide-react": "^1.17.0",
        "mermaid": "^11.4.1",
        "nanoid": "^5.1.16",
        "plotly.js": "^4.1.1",
        "radix-ui": "^1.4.3",
        "react": "^19.2.4",
        "react-chartjs-2": "^5.3.0",
        "react-dom": "^19.2.4",
        "react-plotly.js": "^2.6.0",
        "react-resizable-panels": "^4.19.1",
        "remark-cjk-friendly-gfm-strikethrough": "^2.0.1",
        "shiki": "^4.0.2",
        "streamdown": "^2.5.0",
        "tailwind-merge": "^3.5.0",
        "tailwind-scrollbar-hide": "^4.0.0",
        "tailwindcss": "^4.2.2",
        "three": "^0.185.0",
        "tw-animate-css": "^1.4.0",
        "unified": "^11.0.5",
        "zustand": "^5.0.12"
    },
    "devDependencies": {
        "@babel/core": "^8.1.0",
        "@babel/eslint-parser": "^8.0.7",
        "@types/jsdom": "^30.0.0",
        "@types/katex": "^0.16.7",
        "@types/node": "^22.13.10",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@types/react-plotly.js": "^2.6.4",
        "@types/three": "^0.185.0",
        "@vitejs/plugin-react": "^6.1.2",
        "ai": "^6.0.297",
        "esbuild": "^0.27.7",
        "eslint": "^10.14.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "jsdom": "^30.1.1",
        "shadcn": "^4.1.1",
        "typescript": "^7.0.2",
        "vite": "^8.3.5"
    },
    "engines": {
        "node": ">=22"
    },
    "overrides": {
        "katex": "$katex",
        "@radix-ui/react-dismissable-layer": "1.1.11"
    }
}
