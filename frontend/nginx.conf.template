# An explicit production sandbox URL must also be supplied as the frontend build
# argument VITE_UI_SANDBOX_ORIGIN. The default works on the same host, port 3001.
map "${UI_SANDBOX_ORIGIN}" $ui_sandbox_origin {
    "" "$scheme://$host:3001";
    default "${UI_SANDBOX_ORIGIN}";
}
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    # Constrains even scripted self-navigation of the sandboxed child.
    add_header Content-Security-Policy "frame-src $ui_sandbox_origin blob:; object-src 'none'; base-uri 'self'" always;
    add_header X-Content-Type-Options nosniff always;
    location /api/ {
        # The backend enforces MAX_UPLOAD_SIZE_MB itself; nginx's 1 MB default
        # rejected ordinary PDF and dataset uploads with 413.
        client_max_body_size 0;
        proxy_request_buffering off;
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # Both chat and interactive action endpoints stream SSE.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }
    location /health { proxy_pass http://backend:8000; }
    location / { try_files $uri $uri/ /index.html; }
}
